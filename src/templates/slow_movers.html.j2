<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t.slow_movers_all }} · {{ day.as_of }}</title>
  <style>
    :root { --pos: #1a7f37; --neg: #c0392b; --muted: #666; --line: #e3e3e3; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 56rem; margin: 2rem auto; padding: 0 1rem; color: #1b1b1b; line-height: 1.4; }
    .pos { color: var(--pos); } .neg { color: var(--neg); } .kv { color: var(--muted); font-size: .85rem; }
    .src { font-size: .75rem; color: var(--muted); margin-left: .3rem; text-decoration: none; }
    .card { border: 1px solid var(--line); border-radius: 6px; padding: .8rem 1rem; margin: .8rem 0; }
    .rules span { display: inline-block; background: #eef3fb; border-radius: 3px; padding: .1rem .4rem; margin: .1rem .2rem .1rem 0; font-size: .85rem; }
    .sev { font-size: .75rem; border: 1px solid var(--muted); border-radius: 3px; padding: 0 .3rem; color: var(--muted); }
    .note { background: #fff4e5; border-left: 4px solid #f0b35e; padding: .5rem .8rem; margin: .6rem 0; font-size: .9rem; }
  </style>
</head>
<body>
  <h1>{{ t.slow_movers_all }}</h1>
  <p class="kv">{{ t.as_of }} {{ day.as_of }} · <a href="index.html">{{ t.back_to_brief }}</a></p>
  <p>{{ t.slow_movers_intro }}</p>
  {% set sm = day.sections.slow_movers %}
  {% if sm.error %}<div class="note">{{ t.section_failed }}: {{ sm.error }}</div>
  {% elif not sm.alerts %}<p>{{ t.no_slow_movers }}</p>
  {% else %}
    {% for f in sm.alerts %}
    <div class="card" id="slow-{{ f.ticker }}">
      <strong>{{ f.name }}</strong> <a class="src" href="{{ f.source_url }}" target="_blank" rel="noopener">{{ f.ticker }} ↗</a> <span class="kv">{{ f.sector }}</span> <span class="sev">{{ t.severity }} {{ f.severity }}{% if f.escalation %} · {{ t.escalation }}{% endif %}</span>
      <div class="rules">{% for r in f.rules %}<span>{{ t["rule_" ~ r] }}</span>{% endfor %}</div>
      <div class="kv">{{ t.col_last }} {{ f.last | num }} · {{ t.col_1d }} <span class="{{ f.chg_1d | sign }}">{{ f.chg_1d | chg }}</span> · {{ t.ret_1y }} <span class="{{ f.ret_1y | sign }}">{{ f.ret_1y | chg }}</span> · {{ t.ret_5y }} <span class="{{ f.ret_5y | sign }}">{{ f.ret_5y | chg }}</span></div>
      <div>{{ svgs[f.ticker] | safe }}</div>
    </div>
    {% endfor %}
  {% endif %}
  {% if sm.suppressed %}<p class="kv">{{ sm.suppressed | length }} {{ t.suppressed }}: {% for x in sm.suppressed %}{{ x.ticker }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
</body>
</html>
